# MySQL application database (development values only).
MYSQL_DATABASE=huddle
MYSQL_USER=huddle
MYSQL_PASSWORD=huddle_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# Connection pool settings used by the app.
DB_PORT=3306
DB_POOL_SIZE=10

# Host ports for the web application and Adminer.
APP_PORT=8080
ADMINER_PORT=8081

# MySQL is not published to the host by default. To publish it, set this port
# and select the optional Compose overlay through COMPOSE_FILE in .env.
# Windows: COMPOSE_FILE=docker-compose.yml;docker-compose.db-public.yml
# Linux/macOS: COMPOSE_FILE=docker-compose.yml:docker-compose.db-public.yml
# DB_PUBLISH_PORT=3306